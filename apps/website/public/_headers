/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; connect-src 'self'; font-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/playground/assets/*
  Cache-Control: public, max-age=31536000, immutable

/downloads/*
  Content-Type: application/gzip
  Content-Disposition: attachment

/dashboard/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/participate/*
  Referrer-Policy: no-referrer
