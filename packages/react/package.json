{
  "name": "@fluritheme/fluri-react",
  "version": "0.3.0",
  "description": "React snow effects for websites: Fluri component and hook with DOM-aware snowfall, snow accumulation, Next.js support, and automatic lifecycle cleanup.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE-MIT-LEGACY",
    "LICENSING.md",
    "licensing.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "fluri",
    "react",
    "react-snow",
    "react-snowfall",
    "snow",
    "snowfall",
    "snow-animation",
    "snow-effect",
    "snow-accumulation",
    "winter",
    "christmas",
    "nextjs",
    "react-hooks",
    "typescript",
    "canvas",
    "ssr",
    "animation",
    "yeti",
    "snowball-fight"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../scripts/check-licensing.mjs"
  },
  "peerDependencies": {
    "@fluritheme/fluri": "^0.3.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@fluritheme/fluri": "workspace:*",
    "@types/react": "^19.3.0"
  },
  "homepage": "https://fluri.xyz/",
  "author": {
    "name": "Frantisek Gejdos",
    "url": "https://fluri.xyz/#founder"
  },
  "bugs": {
    "url": "https://github.com/fluritheme/fluri/issues",
    "email": "fluritheme@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluritheme/fluri.git",
    "directory": "packages/react"
  }
}
